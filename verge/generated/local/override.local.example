# =============================================================================
# 本机私有规则配置文件示例（分节配置文件格式）
# 目标文件：override.local（由本文件复制后修改，.gitignore 排除）
# =============================================================================
#
# 【文件格式说明】
# 本文件采用分节（Section-based）配置文件格式，类似 INI 但专为本地规则覆写设计：
# - 使用 [section] 定义节，每节包含特定用途的配置
# - 注释以 # 开头
# - [vps] 节：填写本机公网 IPv4（用于替换模板中的占位符）
# - [rules] 节：YAML 格式的规则列表（带缩进），将被注入到生成配置的最高优先级位置
#
# 【使用说明】
# 1. 复制本文件为 override.local：cp override.local.example override.local
# 2. 编辑 override.local（非本示例文件），在 [vps] 段填写你的公网 IP，在 [rules] 段添加私有规则
# 3. 重新生成配置：bash verge/scripts/render-local.sh <你的公网IP>
# 4. 将生成的 verge/generated/airport-rule-split.local.yaml 复制到 Verge 使用
# 5. 如需修改规则，重复步骤 2-4
#
# 【注意事项】
# - override.local 文件（非本示例）被 .gitignore 排除，不会提交到仓库，适合存放敏感信息
# - 非私有规则（通用规则）请修改 verge/rulesets/_anchors/*.yaml
# - 此处的规则用于纠正系统性配置错误，最高优先级在标准规则之前命中
#
# =============================================================================

[vps]
# 填写你的公网 IPv4（用于替换模板中的 192.0.2.1 占位符）
# 例如：203.0.113.10

[rules]
# ============================================
# 1. 私有直连规则（示例）
# ============================================

# 1.1 本机需要直连的 IP：必须直连，避免回环
#   - IP-CIDR,203.0.113.10/32,🔌 国内直连,no-resolve

# 1.2 云服务商控制台/API/Spaces：本地直连，不经机场隧道
#   - GEOSITE,aws,🔌 国内直连
#   - GEOSITE,azure,🔌 国内直连
#   - GEOSITE,aliyun,🔌 国内直连

# 1.3 机场管理面板：国内运营，固定直连避免登录异常
#   - DOMAIN-SUFFIX,example-airport.org,🔌 国内直连

# 1.4 其他需要直连的本地域名
#   - DOMAIN-SUFFIX,my-home-nas.local,🔌 国内直连


# ============================================
# 2. 手动代理规则（指定节点，示例）
# ============================================
# 用于需要固定节点、不走负载均衡的场景

# 2.1 指定美国节点
#   - DOMAIN-SUFFIX,chatgpt.com,美国
#   - DOMAIN-SUFFIX,openai.com,美国

# 2.2 指定香港节点
#   - DOMAIN-SUFFIX,netflix.com,香港


# ============================================
# 3. 自动选择规则（示例）
# ============================================
# 用于可接受多节点自动切换的场景

# 3.1 海外流媒体
#   - DOMAIN-KEYWORD,youtube,海外音影社
#   - DOMAIN-KEYWORD,netflix,海外音影社

# 3.2 社交媒体
#   - GEOSITE,twitter,社交媒体
#   - GEOSITE,telegram,社交媒体


# ============================================
# 4. 分国家/地区代理规则（示例）
# ============================================

# 4.1 日本
#   - GEOSITE,abema,日本
#   - DOMAIN-SUFFIX,unext.jp,日本

# 4.2 韩国
#   - DOMAIN-SUFFIX,naver.com,韩国

# 4.3 新加坡
#   - DOMAIN-SUFFIX,carousell.sg,新加坡
