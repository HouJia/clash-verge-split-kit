# 复制为同目录下 override.local（本机私稿；整目录规则见仓库根 .gitignore）。
# verge/scripts/render-local.sh 读取：纯文本分节，无大模型参与。
#
# 结构说明：
# [vps]    公网 IPv4，取段内第一个非注释非空行（也可只靠命令行参数 / VPS_PUBLIC_IP）。
# [rules]  所有本地私有规则（最高优先级，在广告拦截之前命中）。
#          按「直连 / 手动代理 / 自动选择 / 分国家」分组，便于维护。

[vps]
# 填写你的公网 IPv4（用于替换模板中的 192.0.2.1 占位符）
# 例如：203.0.113.10

[rules]
# ============================================
# 一、直连规则（DIRECT）
# ============================================
# 原则：手动维护的规则必然准确，放在最前面确保优先命中

# 1.1 本机 VPS：必须直连，避免回环
# - IP-CIDR,203.0.113.10/32,DIRECT,no-resolve

# 1.2 云服务商控制台/API：本地直连，不经机场隧道
# - GEOSITE,aws,DIRECT
# - GEOSITE,azure,DIRECT
# - GEOSITE,aliyun,DIRECT

# 1.3 机场管理面板：国内运营，固定直连避免登录异常
# - DOMAIN-SUFFIX,example-airport.org,DIRECT

# 1.4 其他需要直连的本地域名
# - DOMAIN-SUFFIX,my-home-nas.local,DIRECT


# ============================================
# 二、手动代理（指定节点）
# ============================================
# 用于需要固定节点、不走负载均衡的场景

# 2.1 指定美国节点
# - DOMAIN-SUFFIX,chatgpt.com,美国
# - DOMAIN-SUFFIX,openai.com,美国

# 2.2 指定香港节点
# - DOMAIN-SUFFIX,netflix.com,香港


# ============================================
# 三、自动选择（自动 / 故障转移 / 负载均衡）
# ============================================
# 用于可接受多节点自动切换的场景

# 3.1 海外流媒体（自动选最优）
# - DOMAIN-KEYWORD,youtube,海外音影社
# - DOMAIN-KEYWORD,netflix,海外音影社
# - DOMAIN-KEYWORD,spotify,海外音影社

# 3.2 社交媒体（故障转移）
# - GEOSITE,twitter,社交媒体
# - GEOSITE,telegram,社交媒体


# ============================================
# 四、分国家/地区代理
# ============================================
# 用于明确需要特定地区节点的场景

# 4.1 日本
# - GEOSITE,abema,日本
# - DOMAIN-SUFFIX,unext.jp,日本

# 4.2 韩国
# - DOMAIN-SUFFIX,naver.com,韩国
# - DOMAIN-SUFFIX,melon.com,韩国

# 4.3 新加坡
# - DOMAIN-SUFFIX,carousell.sg,新加坡

# 4.4 其他国家和地区
# - DOMAIN-SUFFIX,bbc.co.uk,英国
# - DOMAIN-SUFFIX,zdf.de,德国


# ============================================
# 五、兜底/测试规则
# ============================================
# - DOMAIN-KEYWORD,critical,DIRECT
# - DOMAIN-SUFFIX,test-internal.local,DIRECT
