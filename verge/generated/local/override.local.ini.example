; =============================================================================
; 本机私有规则配置文件示例（INI 格式）
; 目标文件：override.local.ini（由本文件复制后修改，.gitignore 排除）
; =============================================================================
;
; 【文件格式说明】
; 本文件采用 INI 格式，专为本地规则覆写设计：
; - 使用 [section] 定义节，每节包含特定用途的配置
; - 注释以 ; 开头
; - [rules] 节：INI 格式的规则列表（ruleset=GROUP,[]TYPE,CONTENT,no-resolve）
;
; 【使用说明】
; 1. 复制本文件为 override.local.ini
; 2. 编辑 override.local.ini，在 [rules] 段添加私有规则
; 3. 重新生成配置：bash verge/derive/scripts/render-local.sh
; 4. 生成的配置位于 verge/generated/config.local.yaml
; 5. 如需修改规则，重复步骤 2-4
;
; 【注意事项】
; - override.local.ini 被 .gitignore 排除，不会提交到仓库，适合存放敏感信息
; - 非私有规则（通用规则）请修改 verge/derive/parts/rulesets/*.ini
; - 此处的规则用于纠正系统性配置错误，最高优先级在标准规则之前命中
;
; =============================================================================

[rules]
; ============================================
; 1. 私有直连规则（示例）
; 格式：ruleset=策略组名,[]规则类型,规则内容,no-resolve（可选）
; ============================================

; 1.1 本机需要直连的 IP：必须直连，避免回环
; ruleset=底座 · 🔌 国内直连,[]IP-CIDR,203.0.113.10/32,no-resolve

; 1.2 云服务商控制台/API/Spaces：本地直连，不经机场隧道
; ruleset=底座 · 🔌 国内直连,[]GEOSITE,aws
; ruleset=底座 · 🔌 国内直连,[]GEOSITE,azure
; ruleset=底座 · 🔌 国内直连,[]GEOSITE,aliyun

; 1.3 机场管理面板：国内运营，固定直连避免登录异常
; ruleset=底座 · 🔌 国内直连,[]DOMAIN-SUFFIX,example-airport.org

; 1.4 其他需要直连的本地域名
; ruleset=底座 · 🔌 国内直连,[]DOMAIN-SUFFIX,my-home-nas.local


; ============================================
; 2. 手动代理规则（指定节点，示例）
; ============================================
; 用于需要固定节点、不走负载均衡的场景

; 2.1 指定美国节点
; ruleset=地区 · 🇺🇸 美国节点,[]DOMAIN-SUFFIX,chatgpt.com
; ruleset=地区 · 🇺🇸 美国节点,[]DOMAIN-SUFFIX,openai.com

; 2.2 指定香港节点
; ruleset=地区 · 🇭🇰 香港节点,[]DOMAIN-SUFFIX,netflix.com


; ============================================
; 3. 自动选择规则（示例）
; ============================================
; 用于可接受多节点自动切换的场景

; 3.1 海外流媒体
; ruleset=🎬 场景 · 海外音影社,[]DOMAIN-KEYWORD,youtube
; ruleset=🎬 场景 · 海外音影社,[]DOMAIN-KEYWORD,netflix

; 3.2 社交媒体
; ruleset=💬 场景 · 即时通讯,[]GEOSITE,twitter
; ruleset=💬 场景 · 即时通讯,[]GEOSITE,telegram


; ============================================
; 4. 分国家/地区代理规则（示例）
; ============================================

; 4.1 日本
; ruleset=🇯🇵 地区 · 日本节点,[]GEOSITE,abema
; ruleset=🇯🇵 地区 · 日本节点,[]DOMAIN-SUFFIX,unext.jp

; 4.2 新加坡
; ruleset=🇸🇬 地区 · 新加坡节点,[]DOMAIN-SUFFIX,carousell.sg
