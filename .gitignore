.DS_Store

# --- 本机 / 生成物（命名约定）---
# · *.local.yaml — Mihomo/Verge「粘贴扩展」类本机稿（任意目录），勿提交。
# · verge/generated/ — 脚本与生成器输出目录；仅 **verge/generated/local/*.example** 可入库（本机覆写见同目录 override.local）。
# · verge/analysis/ — 订阅拆解审计材料（可能含脱敏前配置），勿提交。

*.local.yaml

/verge/generated/*
!/verge/generated/local/
/verge/generated/local/*
!/verge/generated/local/*.example

# verge/analysis/ 下各机场目录中的敏感文件（含节点信息）
/verge/analysis/机场A/*.yaml
!/verge/analysis/机场A/modules/*.yaml
/verge/analysis/机场B/*.yaml
!/verge/analysis/机场B/modules/*.yaml
