#!/usr/bin/env sh
# 提交前检查：若修改了 derive/parts/rulesets/*.ini，提示重新生成 config-template.ini
set -e

ROOT="$(git rev-parse --show-toplevel)"

# 检查是否修改了 INI 片段但未更新 config-template.ini
if git diff --cached --name-only | grep -qE '^verge/derive/parts/.*\.ini$'; then
  echo "提示: 检测到 derive/parts/rulesets/*.ini 有修改。" >&2
  echo "      如需更新模板，请运行: bash verge/derive/scripts/compose-ini.sh -o verge/template/config-template.ini" >&2
fi

exit 0
